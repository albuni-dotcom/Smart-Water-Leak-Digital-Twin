{
  "version": 1,
  "author": "Shopak - Mechatronics Team",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-led", "id": "ledA", "top": -90, "left": 180, "attrs": { "color": "green", "label": "Valve A" } },
    { "type": "wokwi-led", "id": "ledB", "top": -90, "left": 230, "attrs": { "color": "green", "label": "Valve B" } },
    { "type": "wokwi-led", "id": "ledC", "top": -90, "left": 280, "attrs": { "color": "green", "label": "Valve C" } },
    { "type": "wokwi-resistor", "id": "rA", "top": -30, "left": 180, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "rB", "top": -30, "left": 230, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "rC", "top": -30, "left": 280, "attrs": { "value": "220" } },

    { "type": "wokwi-pushbutton", "id": "btnMain", "top": 20, "left": -150, "attrs": { "color": "blue", "label": "Flow Main" } },
    { "type": "wokwi-pushbutton", "id": "btnZA", "top": 80, "left": -150, "attrs": { "color": "yellow", "label": "Flow ZA" } },
    { "type": "wokwi-pushbutton", "id": "btnZB", "top": 140, "left": -150, "attrs": { "color": "yellow", "label": "Flow ZB" } },
    { "type": "wokwi-pushbutton", "id": "btnZC", "top": 200, "left": -150, "attrs": { "color": "yellow", "label": "Flow ZC" } },

    { "type": "wokwi-potentiometer", "id": "potMain", "top": 20, "left": 200, "attrs": { "label": "P_Main" } },
    { "type": "wokwi-potentiometer", "id": "potZA", "top": 90, "left": 200, "attrs": { "label": "P_ZoneA" } },
    { "type": "wokwi-potentiometer", "id": "potZB", "top": 160, "left": 200, "attrs": { "label": "P_ZoneB" } },
    { "type": "wokwi-potentiometer", "id": "potZC", "top": 230, "left": 200, "attrs": { "label": "P_ZoneC" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "esp:16", "rA:1", "green", [ "h0" ] ],
    [ "rA:2", "ledA:A", "green", [ "v0" ] ],
    [ "ledA:C", "esp:GND.2", "black", [ "v0" ] ],

    [ "esp:17", "rB:1", "green", [ "h0" ] ],
    [ "rB:2", "ledB:A", "green", [ "v0" ] ],
    [ "ledB:C", "esp:GND.2", "black", [ "v0" ] ],

    [ "esp:18", "rC:1", "green", [ "h0" ] ],
    [ "rC:2", "ledC:A", "green", [ "v0" ] ],
    [ "ledC:C", "esp:GND.2", "black", [ "v0" ] ],

    [ "btnMain:1.r", "esp:27", "blue", [ "h0" ] ],
    [ "btnMain:2.r", "esp:GND.1", "black", [ "h0" ] ],
    [ "btnZA:1.r", "esp:26", "gold", [ "h0" ] ],
    [ "btnZA:2.r", "esp:GND.1", "black", [ "h0" ] ],
    [ "btnZB:1.r", "esp:25", "gold", [ "h0" ] ],
    [ "btnZB:2.r", "esp:GND.1", "black", [ "h0" ] ],
    [ "btnZC:1.r", "esp:33", "gold", [ "h0" ] ],
    [ "btnZC:2.r", "esp:GND.1", "black", [ "h0" ] ],

    [ "potMain:GND", "esp:GND.2", "black", [ "v0" ] ],
    [ "potMain:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "potMain:SIG", "esp:36", "purple", [ "h0" ] ],

    [ "potZA:GND", "esp:GND.2", "black", [ "v0" ] ],
    [ "potZA:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "potZA:SIG", "esp:39", "orange", [ "h0" ] ],

    [ "potZB:GND", "esp:GND.2", "black", [ "v0" ] ],
    [ "potZB:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "potZB:SIG", "esp:34", "orange", [ "h0" ] ],

    [ "potZC:GND", "esp:GND.2", "black", [ "v0" ] ],
    [ "potZC:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "potZC:SIG", "esp:35", "orange", [ "h0" ] ]
  ]
}

